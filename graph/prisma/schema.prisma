generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bet {
  id                   String         @id @default(uuid())
  requestId            String         @unique
  player               String
  referrer             String?
  blockNumber          BigInt
  txHash               String         @unique
  wager                Decimal        @db.Decimal(78, 0)
  netStake             Decimal        @db.Decimal(78, 0)
  jackpotContribution  Decimal        @db.Decimal(78, 0)
  multiplierHundredths Int
  status               BetStatus      @default(PENDING)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  completedAt          DateTime?
  outcome              BetOutcome?
  jackpotEvents        JackpotEvent[]
  @@index([player])
  @@index([referrer])
}

model BetOutcome {
  betId         String      @id
  outcome       OutcomeType
  payout        Decimal     @db.Decimal(78, 0)
  jackpotPayout Decimal     @db.Decimal(78, 0)
  spinsConsumed Int
  fulfillTx     String?
  failureReason String?
  resolvedAt    DateTime    @default(now())
  bet           Bet         @relation(fields: [betId], references: [id], onDelete: Cascade)
}

model Player {
  address           String    @id
  totalBets         Int       @default(0)
  totalWager        Decimal   @default(0) @db.Decimal(78, 0)
  totalPayout       Decimal   @default(0) @db.Decimal(78, 0)
  totalJackpot      Decimal   @default(0) @db.Decimal(78, 0)
  netResult         Decimal   @default(0) @db.Decimal(78, 0)
  lastActive        DateTime?
  totalContribution Decimal   @default(0) @db.Decimal(78, 0)
  lastContribution  DateTime?
  referrer          String?
}

model ReferralReward {
  address   String   @id
  pending   Decimal  @default(0) @db.Decimal(78, 0)
  claimed   Decimal  @default(0) @db.Decimal(78, 0)
  updatedAt DateTime @default(now())
}

model PaymentEvent {
  id               String   @id @default(uuid())
  txHash           String   @unique
  blockNumber      BigInt
  game             String   // game address
  bettor           String
  assignedReferrer String?
  baseCost         Decimal  @db.Decimal(78, 0)
  houseFee         Decimal  @db.Decimal(78, 0)
  referralFee      Decimal  @db.Decimal(78, 0)
  netAmount        Decimal  @db.Decimal(78, 0)
  houseEdgeBps     Int
  referralBps      Int
  // optional: set by indexer if you correlate with game logs
  source           String?
  requestId        String?
  createdAt        DateTime @default(now())

  contributions    ReferralContribution[]

  @@index([game])
  @@index([bettor])
}

model ReferralEdge {
  player     String   @id
  referrer   String?
  assignedAt DateTime @default(now())
}

model ReferralContribution {
  id           String   @id @default(uuid())
  paymentId    String?
  payment      PaymentEvent? @relation(fields: [paymentId], references: [id])
  player       String
  referrer     String?
  level        Int
  amount       Decimal  @db.Decimal(78, 0)
  requestId    String?
  txHash       String
  blockNumber  BigInt
  createdAt    DateTime @default(now())

  @@unique([paymentId, level])
  @@index([requestId])
  @@index([player])
  @@index([referrer])
}

model JackpotEvent {
  id                    BigInt           @id @default(autoincrement())
  betId                 String?
  player                String?
  type                  JackpotEventType
  tierIndex             Int?
  payout                Decimal          @db.Decimal(78, 0)
  consolationMultiplier Decimal?         @db.Decimal(10, 4)
  createdAt             DateTime         @default(now())
  bet                   Bet?             @relation(fields: [betId], references: [id])
}

model LiquiditySnapshot {
  id              BigInt   @id @default(autoincrement())
  timestamp       DateTime @default(now())
  rouletteBalance Decimal  @db.Decimal(78, 0)
  jackpotBalance  Decimal  @db.Decimal(78, 0)
  handlerBalance  Decimal  @db.Decimal(78, 0)
  referralBalance Decimal  @db.Decimal(78, 0)
  houseBalance    Decimal  @db.Decimal(78, 0)
}

model IndexerState {
  id                 Int      @id @default(1)
  lastProcessedBlock BigInt
  lastProcessedHash  String
  updatedAt          DateTime @default(now())
}

enum BetStatus {
  PENDING
  RESOLVED
  FAILED
}

enum OutcomeType {
  LOSE
  MULTIPLIER
  JACKPOT
}

enum JackpotEventType {
  TIER
  JACKPOT
  CONSOLATION
}
