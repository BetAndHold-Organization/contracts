# ── Secrets ──────────────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example
!.env.example.*

# Private keys (deployer keys, Chainlink VRF, Etherscan API, etc.)
*.pem
*.key
*.p12
*.pfx
*.wallet
UTC--*
keystore/

# ── Node / Build artifacts ───────────────────────────────────────────────
node_modules/
dist/
bundle/

# Hardhat
artifacts/
cache/
types/
coverage/

# Foundry
out/
broadcast/
forge-cache/

# ── Local deployment overrides ───────────────────────────────────────────
# The canonical deployment JSON (e.g. arbitrumSepolia.json) IS committed
# so backends + tests can read it. Local-override variants carry private
# data and must stay out.
deployments/**/*.local.json
deployments/**/*-private.json
**/secrets.json

# ── Logs / OS / Editor ───────────────────────────────────────────────────
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
