# ── Secrets ──────────────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example
!.env.example.*

# Private keys (deployer keys, Chainlink VRF, Etherscan API, etc.)
*.pem
*.key
*.p12
*.pfx
*.wallet
UTC--*
keystore/

# ── Node / Build artifacts ───────────────────────────────────────────────
node_modules/
dist/
bundle/

# Hardhat
artifacts/
cache/
types/
coverage/

# Foundry
out/
broadcast/
forge-cache/

# ── Deployment artifacts ─────────────────────────────────────────────────
# Per-environment, regenerated on every redeploy via the deploy scripts.
# Not source of truth — each team produces their own. Kept out of the repo
# so working trees don't drift after a fresh `npm run deploy:testnet`.
deployments/*.json
**/secrets.json

# ── Logs / OS / Editor ───────────────────────────────────────────────────
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
